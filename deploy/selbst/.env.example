# Beispiel für die .env des Selbstbetriebs. setup.sh schreibt die echte .env selbst und
# erzeugt alle Geheimnisse; diese Datei zeigt nur, was darin steht und was es bedeutet.
# Alles hier lässt sich auch als Umgebungsvariable an setup.sh übergeben (Betrieb ohne
# Rückfragen). Die echte .env gehört nie ins Repo (steht in .gitignore).

# --- Adresse -------------------------------------------------------------------------------
# Domain der Teilnahmeseite. Garage bekommt s3.<DOMAIN>; beide Namen müssen per DNS auf den
# Server zeigen, Caddy holt für beide ein Zertifikat.
DOMAIN='upload.example.org'
# Browser-Adresse der Seite, ohne Schrägstrich am Ende (setup.sh leitet sie aus DOMAIN ab).
PUBLIC_ORIGIN='https://upload.example.org'
# Leer: Caddy holt Zertifikate. 'http://': Probemodus ohne Zertifikat (setup.sh --lokal).
SCHEMA=''
# Wer die .env angelegt hat: 'betrieb' oder 'lokal'. Beides lässt sich nicht mischen.
MODUS='betrieb'

# --- Version -------------------------------------------------------------------------------
# Image-Tag; setup.sh setzt ihn aus der Version in pyproject.toml des ausgecheckten Tags.
IMAGE_TAG='v0.2.0'
# Nur für Entwicklung: anderes Image als ghcr.io/northalpha/schwarmstack.
# IMAGE='schwarmstack-test'

# --- Betreiber -----------------------------------------------------------------------------
# Adressen, die Betriebsmeldungen per Mail bekommen (mit Komma getrennt).
OPERATOR_EMAILS='betrieb@example.org'
# Mailserver für diese Meldungen; ohne Angaben gehen keine Mails raus.
# EMAIL_HOST='smtp.example.org'
# EMAIL_PORT='587'
# EMAIL_HOST_USER=''
# EMAIL_HOST_PASSWORD=''
# EMAIL_USE_TLS='1'
# DEFAULT_FROM_EMAIL='schwarmstack@upload.example.org'

# --- Verantwortliche Stelle und Hoster (Datenschutzhinweis) ----------------------------------
OPERATOR_NAME='Beispielverein e. V.'
OPERATOR_ADDRESS='Musterstraße 1, 12345 Musterstadt'
HOSTER_NAME='Beispiel-Hosting GmbH'
HOSTER_ADDRESS='Hosterweg 2, 54321 Hosterstadt'
# Kontakt für Datenschutzanfragen (Mailadresse).
PRIVACY_CONTACT='datenschutz@example.org'

# --- Geheimnisse (setup.sh erzeugt sie, bei weiteren Läufen bleiben sie) ---------------------
DJANGO_SECRET_KEY='…'
# Zufälliger Pfad des Admin: https://<DOMAIN>/<ADMIN_PATH>/
ADMIN_PATH='…'
GARAGE_RPC_SECRET='…'

# --- Speicher (Garage; setup.sh trägt alles ein) ---------------------------------------------
STORAGE_BACKEND='s3'
S3_ENDPOINT_URL='https://s3.upload.example.org'
S3_BUCKET='schwarmstack'
S3_REGION='garage'
S3_ACCESS_KEY_ID='GK…'
S3_SECRET_ACCESS_KEY='…'
S3_ADDRESSING_STYLE='path'

# --- Nur beim ersten Lauf, ohne Eintrag in der .env -------------------------------------------
# Erstes Betreiber-Konto (Standard: betreiber, erste Adresse aus OPERATOR_EMAILS):
#   ADMIN_USER, ADMIN_EMAIL
# Aktion (nur, wenn es noch keine gibt):
#   AKTION_OBJEKT, AKTION_START, AKTION_ENDE (ISO 8601 mit Zeitzone),
#   AKTION_QUOTE_GIB, AKTION_GESAMTGRENZE_GIB
